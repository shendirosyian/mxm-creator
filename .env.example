# GEMINI_API_KEY: Required for Gemini AI API calls and image generation.
# Configure this in your Netlify site settings (Site configuration > Environment variables)
# or in AI Studio Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_IMAGE_MODEL: Optional Gemini image generation model (Default: gemini-3.1-flash-lite-image)
# Supported free image models: gemini-3.1-flash-lite-image
GEMINI_IMAGE_MODEL="gemini-3.1-flash-lite-image"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
