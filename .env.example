# HF_TOKEN: Optional personal Hugging Face user access token (read permission).
# Gives higher ZeroGPU quota priority for Nymbo/Virtual-Try-On.
# Can be obtained from: https://huggingface.co/settings/tokens
# Configure in Netlify site settings (Site configuration > Environment variables).
HF_TOKEN=""

# HF_SPACE_ID: Hugging Face ZeroGPU Virtual Try-On space ID (Default: Nymbo/Virtual-Try-On)
HF_SPACE_ID="Nymbo/Virtual-Try-On"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
