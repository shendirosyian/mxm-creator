# ==============================================================================
# MXM CREATOR - SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# HF_TOKEN (Recommended for dedicated ZeroGPU quota):
# Personal Hugging Face user access token used server-side by Netlify Functions.
# 
# How to create:
# 1. Visit: https://huggingface.co/settings/tokens
# 2. Click "Create new token"
# 3. Token type: "Fine-grained" or "Read"
# 4. Permissions: Set role to "Read" (Read access to public gated repos).
#    * Do NOT grant write, admin, or organization management permissions.
# 
# Where to set:
# - In Netlify: Site configuration > Environment variables > Add a variable:
#     Key: HF_TOKEN
#     Value: hf_...
# - In Local Development: Copy this file to .env and set HF_TOKEN=hf_...
#
# Note on ZeroGPU Quota:
# Authenticated tokens grant access to your personal Hugging Face account's
# ZeroGPU quota (~90 seconds per rolling window) rather than competing for the
# public anonymous IP pool. Personal tokens do not eliminate GPU limits;
# once your personal quota is consumed, wait for the standard refresh window.
HF_TOKEN=""

# HF_SPACE_ID: Hugging Face ZeroGPU Virtual Try-On space ID
# Defaults to "Nymbo/Virtual-Try-On" (768x1024 IDM-VTON ZeroGPU Space)
# Alternative supported: "yisol/IDM-VTON"
HF_SPACE_ID="Nymbo/Virtual-Try-On"

# APP_URL: The public URL where this applet is hosted
APP_URL="MY_APP_URL"
